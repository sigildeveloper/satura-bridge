# Bluetooth: BTstack + встроенный контроллер, только Classic для PAN
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

CONFIG_BTSTACK_INTERNAL_BT=y
CONFIG_BTSTACK_AUDIO=n

# Wi‑Fi и Bluetooth работают одновременно
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# Wi‑Fi
CONFIG_ESP_WIFI_ENABLED=y

# Веб-интерфейс
CONFIG_ESP_HTTP_SERVER_ENABLE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024

# Маршрутизация BT PAN -, Wi‑Fi
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y

# DHCP-клиент
CONFIG_LWIP_DHCP_DOES_ARP_CHECK=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# Needed for xTaskGetHandle() — watchdog uses it to find the httpd
# task by name and log its stack high-water mark.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Flash / разделы
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"

# Освобождаем IRAM для связки Wi‑Fi + BT PAN
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# -Os is load-bearing: BT + WiFi coexistence is close enough to the
# IRAM budget (see idf.py size) that -Og/-O0 have been observed to
# overflow it on the sibling Vetera Bridge project (same BT+WiFi
# stack). Pin it explicitly so a menuconfig default drift or a fresh
# clone can't silently regress this.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Не используются проектом
CONFIG_LWIP_IPV4_NAPT_PORTMAP=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DNS_SUPPORT_MDNS_QUERIES=n
CONFIG_LWIP_DHCPS=n

# Wi‑Fi менеджер поддерживает OPEN/WPA2-PSK, не Enterprise/WPA3
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_BTSTACK_HCI_DUMP_STDOUT=n
